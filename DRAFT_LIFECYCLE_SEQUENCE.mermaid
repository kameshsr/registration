%%{init: {'themeVariables': { 'activationBkgColor': '#80ffd5', 'activationBorderColor': '#009977' }}}%%
sequenceDiagram
    participant reg_processor as Registration Processor
    participant identity_service as Identity Service (IDRepo)
    participant vid_service as VID Service
    participant object_store as Object Store (S3/MinIO)
    participant credential_request_generator as Credential Request Generator
    participant credential_service as Credential Service
    participant data_share as Data Share
    participant websub as WebSub
    participant ida as ID Authentication

    %% ─────────────────────────────────────────────────────────────────
    Note over reg_processor,identity_service: STEP 1: UIN Generator Stage
    %% ─────────────────────────────────────────────────────────────────

    reg_processor->>identity_service: HEAD /identity/draft/{regId} (hasDraft check)
    activate identity_service
    identity_service-->>reg_processor: 204 No Content (draft not found)
    deactivate identity_service

    reg_processor->>identity_service: POST /identity/draft/create/{regId}?UIN={uin}
    activate identity_service
    identity_service->>identity_service: Generate new UIN (if new registration)<br/>or clone existing identity (if correction/update)
    identity_service->>object_store: Store identity documents
    identity_service-->>reg_processor: Draft created (status=DRAFTED)
    deactivate identity_service

    reg_processor->>identity_service: PATCH /identity/draft/update/{regId}
    activate identity_service
    identity_service->>identity_service: Merge demographic data + biometrics<br/>into draft (JSONCompare diff)
    identity_service->>object_store: Upload changed documents / biometrics
    identity_service-->>reg_processor: Draft updated (status=DRAFTED)
    deactivate identity_service

    %% ─────────────────────────────────────────────────────────────────
    Note over reg_processor,object_store: STEP 2: Biometric Extraction Stage
    %% ─────────────────────────────────────────────────────────────────

    reg_processor->>identity_service: HEAD /identity/draft/{regId} (hasDraft check)
    activate identity_service
    identity_service-->>reg_processor: 200 OK (draft exists)
    deactivate identity_service

    reg_processor->>identity_service: PUT /identity/draft/extractbiometrics/{regId}?finger=..&iris=..&face=..
    activate identity_service
    identity_service->>object_store: Read raw CBEFF biometric file
    object_store-->>identity_service: CBEFF bytes
    identity_service->>identity_service: Call BioSDK service to extract templates<br/>POST /biosdk-service/{format}/extracttemplates
    identity_service->>object_store: Write extracted template files<br/>(e.g. individualBiometrics.finger.ISO_19794_4_2011)
    identity_service-->>reg_processor: Biometrics extracted (status=DRAFTED)
    deactivate identity_service

    %% ─────────────────────────────────────────────────────────────────
    Note over reg_processor,vid_service: STEP 3: Finalization Stage — publishDraft
    %% ─────────────────────────────────────────────────────────────────

    reg_processor->>identity_service: HEAD /identity/draft/{regId} (hasDraft check)
    activate identity_service
    identity_service-->>reg_processor: 200 OK (draft exists)
    deactivate identity_service

    reg_processor->>identity_service: GET /identity/draft/publish/{regId}
    activate identity_service

    identity_service->>vid_service: POST /idrepository/v1/draft/vid<br/>{ uin, vidType: PERPETUAL } — create DRAFT VID
    activate vid_service
    vid_service-->>identity_service: { VID: "123..." } (status=DRAFT)
    deactivate vid_service

    identity_service->>identity_service: INSERT identity into uin table (new)<br/>or UPDATE uin table (correction)
    identity_service->>object_store: Store final identity documents + biometrics
    identity_service->>identity_service: INSERT into uin_history

    identity_service->>vid_service: PATCH /idrepository/v1/vid/{vid}<br/>{ vidStatus: ACTIVE } — activate VID
    activate vid_service
    vid_service-->>identity_service: VID activated
    deactivate vid_service

    identity_service->>identity_service: Delete draft row from uin_draft table
    identity_service-->>reg_processor: Identity published (status=ACTIVATED)
    deactivate identity_service

    %% ─────────────────────────────────────────────────────────────────
    Note over identity_service,credential_request_generator: STEP 4: Credential Generation
    %% ─────────────────────────────────────────────────────────────────

    identity_service->>identity_service: Creates entry with status NEW<br/>into credential_request_status table

    identity_service->>identity_service: CredentialStatusHandler job runs

    identity_service->>credential_request_generator: POST /credentialrequest/requestgenerator<br/>Credential request for each UIN/VID/handle per partner
    activate credential_request_generator
    credential_request_generator->>credential_request_generator: Entry created with status NEW<br/>in credential_transaction table
    credential_request_generator-->>identity_service: Credential request accepted
    deactivate credential_request_generator

    identity_service->>identity_service: Status updated to REQUESTED<br/>in credential_request_status table

    %% ─────────────────────────────────────────────────────────────────
    Note over credential_request_generator,websub: STEP 5: Credential Issuance
    %% ─────────────────────────────────────────────────────────────────

    credential_request_generator->>credential_request_generator: CredentialProcess job runs

    credential_request_generator->>credential_service: POST /credentials/issue<br/>Credential issue request
    activate credential_service

    credential_service->>data_share: Request datashare URL<br/>(demographic + biometric data)
    activate data_share
    data_share-->>credential_service: Datashare URL generated
    deactivate data_share

    credential_service->>websub: Publish credential event to IDA topic
    activate websub
    websub-->>credential_service: Event published successfully
    deactivate websub

    credential_service-->>credential_request_generator: Credential issued successfully
    deactivate credential_service

    credential_request_generator->>credential_request_generator: Status updated to ISSUED<br/>in credential_transaction table

    %% ─────────────────────────────────────────────────────────────────
    Note over ida,websub: STEP 6: IDA Credential Processing
    %% ─────────────────────────────────────────────────────────────────

    ida-->>websub: Subscribes to UIN/VID credential events
    websub-->>ida: Notifies credential event

    ida->>ida: Stores event in credential_event_store table<br/>with status NEW

    ida->>ida: CredentialStoreJob runs

    ida->>data_share: Download demographic + biometric data<br/>using datashare URL
    activate data_share
    data_share-->>ida: Data downloaded successfully
    deactivate data_share

    ida->>ida: Re-encrypt data under IDA's key manager<br/>Store in identity_cache table<br/>Update credential_event_store status to STORED

    %% ─────────────────────────────────────────────────────────────────
    Note over ida,credential_request_generator: STEP 7: Acknowledgement
    %% ─────────────────────────────────────────────────────────────────

    ida->>websub: Publish CREDENTIAL_STATUS_UPDATE event
    activate websub
    credential_request_generator-->>websub: Subscribes to callback events
    websub-->>credential_request_generator: Notifies callback event
    deactivate websub

    credential_request_generator->>credential_request_generator: Status updated to STORED<br/>in credential_transaction table
